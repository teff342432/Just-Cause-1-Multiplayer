name: Build JC1MP Complete

on:
  workflow_dispatch:
  push:
    paths:
      - 'client/**'
      - 'dinput8/**'
      - 'masterserver/**'
      - 'external/**'
      - 'shared/**'
      - 'globals/**'
      - 'tcp/**'
      - 'tcp_client/**'
      - 'tcp_server/**'
      - 'profiling/**'
      - 'hde/**'
      - 'scripting/**'
      - 'utils/**'
      - 'thread_system/**'
      - 'sql/**'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: windows-2022

    steps:
      - name: Baixar codigo
        uses: actions/checkout@v4

      - name: Preparar MSBuild
        uses: microsoft/setup-msbuild@v2

      - name: Instalar DirectX D3DX
        shell: pwsh
        run: |
          $url = "https://api.nuget.org/v3-flatcontainer/microsoft.dxsdk.d3dx/9.29.952.8/microsoft.dxsdk.d3dx.9.29.952.8.nupkg"
          $pkg = "$env:RUNNER_TEMP\dxsdk.nupkg"
          $dest = "$env:RUNNER_TEMP\dxsdk"

          Write-Host "Baixando DirectX D3DX..."
          Invoke-WebRequest -Uri $url -OutFile $pkg

          Write-Host "Extraindo pacote..."
          Expand-Archive -Path $pkg -DestinationPath $dest -Force

          $header = Get-ChildItem -Path $dest -Filter "d3dx9math.h" -Recurse |
            Select-Object -First 1

          if (-not $header) {
            throw "ERRO: d3dx9math.h nao encontrado no pacote."
          }

          $lib = Get-ChildItem -Path $dest -Filter "d3dx9.lib" -Recurse |
            Where-Object { $_.FullName -match '[\\/]x86[\\/]' } |
            Select-Object -First 1

          if (-not $lib) {
            throw "ERRO: d3dx9.lib para Win32 nao encontrada."
          }

          "INCLUDE=$($header.Directory.FullName);$env:INCLUDE" |
            Out-File -FilePath $env:GITHUB_ENV -Append

          "LIB=$($lib.Directory.FullName);$env:LIB" |
            Out-File -FilePath $env:GITHUB_ENV -Append

          Write-Host "DirectX D3DX configurado."
          Write-Host "Header: $($header.FullName)"
          Write-Host "Library: $($lib.FullName)"

      - name: Compilar jcmp_client.dll
        shell: pwsh
        run: |
          msbuild client\client.vcxproj /m /p:Configuration=Release /p:Platform=Win32 "/p:SolutionDir=$($env:GITHUB_WORKSPACE)/" /p:PostBuildEventUseInBuild=false
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Compilar dinput8.dll
        shell: pwsh
        run: |
          msbuild dinput8\dinput8.vcxproj /m /p:Configuration=Release /p:Platform=Win32 "/p:SolutionDir=$($env:GITHUB_WORKSPACE)/" /p:PostBuildEventUseInBuild=false
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Compilar masterserver.exe
        shell: pwsh
        run: |
          msbuild masterserver\masterserver.vcxproj /m /p:Configuration=Release /p:Platform=Win32 "/p:SolutionDir=$($env:GITHUB_WORKSPACE)/" /p:PostBuildEventUseInBuild=false
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Conferir arquivos
        shell: pwsh
        run: |
          Get-Item bins\client\jcmp_client.dll
          Get-Item bins\client\dinput8.dll
          Get-Item bins\ms\masterserver.exe

      - name: Disponibilizar download
        uses: actions/upload-artifact@v4
        with:
          name: JC1MP-Complete
          path: |
            bins/client/jcmp_client.dll
            bins/client/dinput8.dll
            bins/ms/masterserver.exe
          if-no-files-found: error
